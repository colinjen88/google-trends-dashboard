{
  "name": "google-trends-dashboard",
  "version": "2.1.0",
  "description": "現代化 Google Trends 資料視覺化儀表板，支援無限圖表、即時熱搜、關鍵字排名追蹤",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx live-server --port=8080",
    "dev:server": "npx nodemon server.js",
    "lint": "npx eslint assets/js/",
    "format": "npx prettier --write \"**/*.{html,css,js,md}\"",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinjen88/google-trends-dashboard.git"
  },
  "keywords": [
    "google-trends",
    "dashboard",
    "analytics",
    "seo",
    "rank-tracking",
    "data-visualization"
  ],
  "author": "Colinjen88",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/colinjen88/google-trends-dashboard/issues"
  },
  "homepage": "https://github.com/colinjen88/google-trends-dashboard#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "optionalDependencies": {
    "puppeteer": "^21.0.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "live-server": "^1.2.2",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}